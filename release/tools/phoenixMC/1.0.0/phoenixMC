#!/bin/bash
# PhoenixMC Upload Tool Wrapper for XR871
# This tool uploads firmware to XR871 via serial port

PORT=""
BAUD="115200"
BIN_FILE=""
TARGET="xr871"

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --port) PORT="$2"; shift 2;;
        --baud) BAUD="$2"; shift 2;;
        --bin) BIN_FILE="$2"; shift 2;;
        --target) TARGET="$2"; shift 2;;
        *) shift;;
    esac
done

if [ -z "$PORT" ] || [ -z "$BIN_FILE" ]; then
    echo "Usage: phoenixMC --port <port> --baud <baud> --bin <file> --target <target>"
    exit 1
fi

if [ ! -f "$BIN_FILE" ]; then
    echo "ERROR: Binary file not found: $BIN_FILE"
    exit 1
fi

echo "PhoenixMC Upload Tool"
echo "Target: $TARGET"
echo "Port: $PORT"
echo "Baud: $BAUD"
echo "File: $BIN_FILE"
echo ""
echo "NOTE: Please install phoenixMC tool from XradioTech"
echo "Downloading from: https://github.com/XradioTech/XR871-OLD/tree/master/05_TOOLS"
echo ""
echo "Manual upload command:"
echo "  phoenixMC --port $PORT --baud $BAUD --bin $BIN_FILE --target $TARGET"
